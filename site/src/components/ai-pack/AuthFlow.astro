---
import VizFrame from './VizFrame.astro';
---

<VizFrame
  title="authorization flow"
  label="Diagram: the AI agent connects to the Flux MCP Server over HTTPS. The MCP Server contains its own authorization server, which signs the user in through your identity provider or the Dex addon. No external OAuth authorization server is needed."
>
  <div class="flow">
    <div class="node agent">
      <span class="node-icon">
        <svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" /></svg>
      </span>
      <span class="node-text">
        <span class="node-name">AI agent</span>
        <span class="node-sub">MCP client</span>
      </span>
    </div>

    <div class="wire">
      <span class="wire-line"></span>
      <span class="wire-tag">HTTPS</span>
    </div>

    <div class="server">
      <p class="server-head">
        <img src="/images/logo/enterprise-for-flux-cd-icon-white.svg" alt="" width="18" height="18" />
        Flux MCP Server
      </p>
      <div class="modules">
        <div class="module auth">
          <span class="module-name">Authorization server</span>
          <span class="module-sub">built in · issues scoped tokens</span>
        </div>
        <div class="module">
          <span class="module-name">MCP tools</span>
          <span class="module-sub">checked against each token</span>
        </div>
      </div>
    </div>

    <div class="ghost">
      <span class="ghost-name">External OAuth server</span>
      <span class="ghost-tag">not needed</span>
    </div>

    <div class="wire">
      <span class="wire-line"></span>
      <span class="wire-tag">SSO sign-in</span>
    </div>

    <div class="node idp">
      <span class="node-icon">
        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
      </span>
      <span class="node-text">
        <span class="node-name">Your identity provider</span>
        <span class="node-sub">your SSO provider, or the Dex addon</span>
      </span>
    </div>
  </div>
</VizFrame>

<style>
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8.5rem;
    column-gap: 1rem;
    justify-items: center;
    align-items: center;
  }

  .flow > * {
    grid-column: 1;
  }

  .server {
    justify-self: stretch;
  }

  .flow > .ghost {
    grid-column: 2;
    grid-row: 3;
    justify-self: stretch;
  }

  .node {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: min(100%, 17rem);
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--navy-line);
    background: rgba(14, 28, 54, 0.75);
  }

  .node-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: rgba(114, 174, 250, 0.14);
    color: var(--brand-light);
  }

  .node-icon svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .node-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .node-name {
    font-weight: 600;
    font-size: 0.86rem;
    color: #ffffff;
  }

  .node-sub {
    font-size: 0.7rem;
    color: #8fa1bd;
  }

  .wire {
    position: relative;
    height: 2.6rem;
    display: flex;
    justify-content: center;
  }

  .wire-line {
    width: 0;
    border-left: 1.5px dashed var(--viz-line-strong);
  }

  .wire-tag {
    position: absolute;
    top: 50%;
    left: calc(50% + 0.75rem);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: #8fa1bd;
    white-space: nowrap;
  }

  .server {
    padding: 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--viz-line-strong);
    background: linear-gradient(180deg, #0f2246, #0a1730);
    box-shadow: 0 0 0 4px rgba(20, 114, 235, 0.08);
  }

  .server-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-weight: 650;
    font-size: 0.88rem;
    color: #ffffff;
  }

  .modules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .module {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--navy-line);
    background: rgba(5, 11, 22, 0.6);
  }

  .module.auth {
    border-color: var(--brand-light);
    background: rgba(20, 114, 235, 0.18);
    box-shadow: 0 0 18px rgba(114, 174, 250, 0.25);
  }

  .module-name {
    font-size: 0.76rem;
    font-weight: 650;
    color: #ffffff;
  }

  .module-sub {
    font-size: 0.66rem;
    color: var(--viz-soft);
  }

  .ghost {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-md);
    border: 1.5px dashed #2a3b5c;
  }

  .ghost::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: 1rem;
    border-top: 1.5px dashed #2a3b5c;
  }

  .ghost-name {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--viz-faint);
    text-decoration: line-through;
    text-decoration-color: var(--viz-faint);
  }

  .ghost-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--viz-ok);
    background: rgba(52, 211, 153, 0.12);
    border-radius: 99px;
    padding: 0.05rem 0.45rem;
  }

  @media (max-width: 520px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .flow > .ghost {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.6rem;
    }

    .ghost {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .ghost::before {
      display: none;
    }

    .modules {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
