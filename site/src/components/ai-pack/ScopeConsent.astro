---
import VizFrame from './VizFrame.astro';

const scopes = [
  { name: 'Read Flux resources and events', tools: 'get_flux_instance, get_kubernetes_resources, get_kubernetes_events', on: true },
  { name: 'Read workload logs', tools: 'get_kubernetes_logs', on: true },
  { name: 'Preview changes with a dry-run diff', tools: 'diff_kubernetes_manifest', on: true },
  { name: 'Reconcile, suspend, and resume', tools: 'reconcile_flux_resource, suspend_flux_reconciliation, resume_flux_reconciliation', on: false },
  { name: 'Apply, patch, and delete', tools: 'apply_kubernetes_manifest, patch_kubernetes_resource, delete_kubernetes_resource', on: false },
];
---

<VizFrame
  light
  lock
  title="flux-mcp.example.com/authorize"
  label="Mockup of the scope selection page: the signed-in user allows an AI agent to read Flux resources, events and workload logs and to preview changes with a dry-run diff, leaves reconcile, apply, patch and delete unchecked, and keeps offline access turned off."
>
  <div class="pair">
    <span class="app agent">
      <svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" /></svg>
    </span>
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="app flux">
      <img src="/images/logo/enterprise-for-flux-cd-icon-white.svg" alt="" width="22" height="22" />
    </span>
  </div>

  <p class="title">Allow your AI agent to access Flux</p>
  <p class="sub">Signed in as <b>ana@example.com</b>. Choose what this agent can do.</p>

  <ul class="scopes">
    {
      scopes.map(({ name, tools, on }) => (
        <li class:list={['scope', { on }]}>
          <span class="box">
            {on && (
              <svg viewBox="0 0 24 24">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
          </span>
          <span class="scope-text">
            <span class="scope-name">{name}</span>
            <span class="scope-tools">{tools}</span>
          </span>
        </li>
      ))
    }
  </ul>

  <div class="offline">
    <span class="scope-text">
      <span class="scope-name">Offline access</span>
      <span class="offline-sub">Keep the session alive without signing in again</span>
    </span>
    <span class="toggle"><span></span></span>
  </div>

  <div class="actions">
    <span class="btn">Cancel</span>
    <span class="btn primary">Allow access</span>
  </div>
</VizFrame>

<style>
  .pair {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0.4rem 0 1rem;
  }

  .app {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
  }

  .app.agent {
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    color: var(--brand);
  }

  .app.agent svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .app.flux {
    background: linear-gradient(135deg, var(--brand-deep), var(--brand));
    box-shadow: 0 6px 16px rgba(20, 114, 235, 0.3);
  }

  .dots {
    display: flex;
    gap: 0.25rem;
  }

  .dots i {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .title {
    margin: 0;
    text-align: center;
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  .sub {
    margin: 0.2rem 0 1.1rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .sub b {
    color: var(--fg);
    font-weight: 600;
  }

  .scopes {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .scope {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
  }

  .scope + .scope {
    border-top: 1px solid var(--border);
  }

  .scope.on {
    background: color-mix(in srgb, var(--brand) 5%, #ffffff);
  }

  .box {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 4px;
    border: 1.5px solid var(--border-strong);
    background: #ffffff;
  }

  .on .box {
    border-color: var(--brand);
    background: var(--brand);
  }

  .box svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: #ffffff;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scope-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .scope-name {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .scope:not(.on) .scope-name {
    color: var(--muted);
  }

  .scope-tools {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  .offline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .offline-sub {
    font-size: 0.7rem;
    color: var(--muted);
  }

  .toggle {
    flex-shrink: 0;
    position: relative;
    width: 2.1rem;
    height: 1.2rem;
    border-radius: 99px;
    background: var(--border-strong);
  }

  .toggle span {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(16, 28, 48, 0.25);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  .btn {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    color: var(--fg);
  }

  .btn.primary {
    background: var(--brand);
    border-color: var(--brand);
    color: #ffffff;
  }
</style>
