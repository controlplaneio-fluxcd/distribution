<script>
  document.querySelectorAll<HTMLElement>('[data-scope-consent]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.scope'));
    const rows = items.map((li) => ({
      label: li.dataset.label ?? '',
      coveredBy: JSON.parse(li.dataset.coveredBy ?? '[]') as string[],
    }));
    const checked = items.map((li) => li.classList.contains('on'));

    const render = (i: number): void => {
      items[i].classList.toggle('on', checked[i]);
      items[i].setAttribute('aria-checked', String(checked[i]));
    };
    const covers = (i: number): number[] => {
      const out: number[] = [];
      rows.forEach((row, j) => {
        if (row.coveredBy.includes(rows[i].label)) out.push(j);
      });
      return out;
    };
    const apply = (i: number, value: boolean): void => {
      checked[i] = value;
      render(i);
    };
    const syncAggregates = (): void => {
      rows.forEach((_row, i) => {
        const kids = covers(i);
        if (kids.length === 0) return;
        const all = kids.every((j) => checked[j]);
        if (checked[i] !== all) apply(i, all);
      });
    };
    const toggleRow = (i: number): void => {
      const value = !checked[i];
      apply(i, value);
      covers(i).forEach((j) => apply(j, value));
      syncAggregates();
    };

    items.forEach((li, i) => {
      li.tabIndex = 0;
      li.setAttribute('role', 'checkbox');
      li.setAttribute('aria-checked', String(checked[i]));
      li.addEventListener('click', () => toggleRow(i));
      li.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          toggleRow(i);
        }
      });
    });

    const toggle = root.querySelector<HTMLElement>('[data-offline]');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const on = !toggle.classList.contains('on');
        toggle.classList.toggle('on', on);
        toggle.setAttribute('aria-checked', String(on));
      });
    }

    const info = root.querySelector<HTMLElement>('[data-info]');
    const pop = root.querySelector<HTMLElement>('[data-info-pop]');
    if (info && pop) {
      const wrap = info.closest<HTMLElement>('.sub-wrap') ?? root;
      const hoverable = window.matchMedia('(hover: hover)').matches;
      let hideTimer: ReturnType<typeof setTimeout>;
      let openBeforePress = false;
      const show = (): void => {
        clearTimeout(hideTimer);
        pop.classList.add('show');
        info.classList.add('active');
        info.setAttribute('aria-expanded', 'true');
      };
      const hide = (): void => {
        clearTimeout(hideTimer);
        pop.classList.remove('show');
        info.classList.remove('active');
        info.setAttribute('aria-expanded', 'false');
      };
      const scheduleHide = (): void => {
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hide, 150);
      };
      info.addEventListener('mouseenter', show);
      info.addEventListener('mouseleave', scheduleHide);
      pop.addEventListener('mouseenter', show);
      pop.addEventListener('mouseleave', scheduleHide);
      info.addEventListener('focus', show);
      // Focus moving between the icon and the popup stays inside the wrapper,
      // so selecting a tab must not close the popup.
      wrap.addEventListener('focusout', (e: FocusEvent) => {
        const next = e.relatedTarget as Node | null;
        if (next && wrap.contains(next)) return;
        scheduleHide();
      });
      // Touch has no hover, so a tap toggles. Record whether the popup was
      // already open when the press began, before any synthetic hover opens it.
      info.addEventListener('pointerdown', () => {
        openBeforePress = pop.classList.contains('show');
      });
      info.addEventListener('click', () => {
        if (hoverable) return;
        if (openBeforePress) hide();
        else show();
      });
      // Pressing anywhere inside the popup keeps it open; pressing outside
      // closes it.
      pop.addEventListener('pointerdown', show);
      document.addEventListener('pointerdown', (e: PointerEvent) => {
        if (!pop.classList.contains('show')) return;
        if (wrap.contains(e.target as Node)) return;
        hide();
      });
      pop.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          pop.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => {
            const active = t === tab;
            t.classList.toggle('active', active);
            t.setAttribute('aria-selected', String(active));
          });
          pop.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.panel !== tab.dataset.tab;
          });
        });
      });
    }

    root.querySelector<HTMLElement>('[data-unselect-all]')?.addEventListener('click', () => {
      rows.forEach((_row, i) => apply(i, false));
      syncAggregates();
    });

    syncAggregates();
  });
</script>

<style>
  .consent {
    color: var(--fg);
    /* The site sets html { line-height: 1.65 }; the standalone consent page
       uses the default, so reset it here to keep the two identical. */
    line-height: normal;
  }

  .pair {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0.4rem 0 1rem;
  }

  .app {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
  }

  .app.agent {
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    color: var(--brand);
  }

  .app.agent svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .app.flux {
    background: linear-gradient(135deg, var(--brand-deep), var(--brand));
    box-shadow: 0 6px 16px rgba(20, 114, 235, 0.3);
  }

  .app.flux svg {
    width: 22px;
    height: 22px;
  }

  .dots {
    display: flex;
    gap: 0.25rem;
  }

  .dots i {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .title {
    margin: 0;
    text-align: center;
    font-weight: 500;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .title b {
    color: var(--fg);
    font-weight: 700;
  }

  .sub {
    margin: 0.2rem 0 1.1rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .sub b {
    color: var(--fg);
    font-weight: 600;
  }

  .scopes {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .scope {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    cursor: pointer;
  }

  .scope + .scope {
    border-top: 1px solid var(--border);
  }

  .scope.on {
    background: color-mix(in srgb, var(--brand) 5%, #ffffff);
  }

  .scope:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .box {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 4px;
    border: 1.5px solid var(--border-strong);
    background: #ffffff;
  }

  .on .box {
    border-color: var(--brand);
    background: var(--brand);
  }

  .box svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: #ffffff;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scope-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .scope-name {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .scope:not(.on) .scope-name {
    color: var(--muted);
  }

  .scope-tools {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  .offline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .offline-sub {
    font-size: 0.7rem;
    color: var(--muted);
  }

  .toggle {
    flex-shrink: 0;
    position: relative;
    width: 2.1rem;
    height: 1.2rem;
    border-radius: 99px;
    background: var(--border-strong);
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .toggle.on {
    background: var(--brand);
  }

  .toggle span {
    position: absolute;
