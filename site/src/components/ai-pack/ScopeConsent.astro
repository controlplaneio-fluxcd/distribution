---
import VizFrame from './VizFrame.astro';

// Marketing mockup of the OAuth2 consent page. Initial state is chosen for the
// page (read-only access with all of its read categories) rather than the
// product's own defaults. The interaction model mirrors the real page:
// category rows toggle, the coarse read-only/full-access rows select everything
// they cover and reflect their children, offline access is a toggle, and the
// info icon reveals the Kubernetes/SSO debug popup. The primary button is inert
// on the marketing page.

interface Row {
  label: string;
  tools: string;
  coveredBy: string[];
  on: boolean;
}

const rows: Row[] = [
  { label: 'Read-only access', tools: '', coveredBy: ['Full access'], on: true },
  { label: 'Full access', tools: '', coveredBy: [], on: false },
  {
    label: 'Cluster discovery',
    tools: 'get_kubernetes_api_versions, list_clusters, list_cluster_tools, describe_cluster_tools, call_cluster_tool',
    coveredBy: ['Read-only access', 'Full access'],
    on: true,
  },
  {
    label: 'Read resources and events',
    tools: 'get_flux_instance, get_kubernetes_resources, get_kubernetes_events',
    coveredBy: ['Read-only access', 'Full access'],
    on: true,
  },
  {
    label: 'Read workload logs and metrics',
    tools: 'get_kubernetes_logs, get_kubernetes_metrics',
    coveredBy: ['Read-only access', 'Full access'],
    on: true,
  },
  {
    label: 'Read Flux documentation',
    tools: 'search_flux_docs, read_flux_doc',
    coveredBy: ['Read-only access', 'Full access'],
    on: true,
  },
  {
    label: 'Preview changes with a dry-run diff',
    tools: 'diff_kubernetes_manifest',
    coveredBy: ['Read-only access', 'Full access'],
    on: true,
  },
  {
    label: 'Suspend, resume and reconcile Flux resources',
    tools: 'suspend_flux_reconciliation, resume_flux_reconciliation, reconcile_flux_resource',
    coveredBy: ['Full access'],
    on: false,
  },
  {
    label: 'Apply, patch and delete resources',
    tools: 'apply_kubernetes_manifest, patch_kubernetes_resource, delete_kubernetes_resource',
    coveredBy: ['Full access'],
    on: false,
  },
  { label: 'Install Flux', tools: 'install_flux_instance', coveredBy: ['Full access'], on: false },
  {
    label: 'Inspect user Kubernetes impersonation and SSO claims',
    tools: 'get_authentication_info',
    coveredBy: ['Full access'],
    on: false,
  },
];

const impersonation = {
  username: 'ana@example.com',
  groups: ['developers', 'sre'],
};

const providerClaims = {
  iss: 'https://dex.example.com',
  sub: 'Cgcy0tC1NTA2EzGnaXRodWI',
  aud: 'flux-mcp-enterprise',
  exp: 1792854484,
  iat: 1792850484,
  nonce: 'nSr3LwRFLANSx0R7r0XnAndpvntdVHcaZSdzrG0Ew',
  at_hash: '74y9c1uUxsGRLc5U9cTS7g',
  email: 'ana@example.com',
  email_verified: true,
  name: 'Ana Silva',
  preferred_username: 'ana',
  groups: ['developers', 'sre'],
};

const escapeHTML = (text: string): string =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// highlightJSON pretty-prints and syntax-highlights a value for innerHTML.
const highlightJSON = (value: unknown): string => {
  const json = escapeHTML(JSON.stringify(value, null, 2));
  const token =
    /("(?:\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(?:true|false|null)\b|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)/g;
  return json.replace(token, (match) => {
    let cls = 'json-number';
    if (match.startsWith('"')) {
      cls = match.endsWith(':') ? 'json-key' : 'json-string';
    } else if (match === 'true' || match === 'false' || match === 'null') {
      cls = 'json-literal';
    }
    return `<span class="${cls}">${match}</span>`;
  });
};
